{
  "name": "reading-machine-interaction-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "build": "node scripts/assemble-model-assets.mjs && tsc --noEmit && node scripts/copy-pdf-assets.mjs && vite build --configLoader runner",
